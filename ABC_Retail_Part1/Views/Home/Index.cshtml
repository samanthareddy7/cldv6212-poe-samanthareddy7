@{
    ViewData["Title"] = "Home";
}

<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&display=swap" rel="stylesheet">

<h1 class="welcome">Welcome to ABC Retail</h1>

<div class="dashboard-container">
    <!-- Customers -->
    <a href="/Customer" class="dashboard-button">
        <div class="button-image">
            <img src="~/images/istockphoto-980667436-612x612.jpg" alt="Customers">
        </div>
        <span>Customers</span>
    </a>

    <!-- Products -->
    <a href="/Product" class="dashboard-button">
        <div class="button-image">
            <img src="~/images/3d0a639a53a2b1ab1cca50c35de29a5e.jpg" alt="Products">
        </div>
        <span>Products</span>
    </a>

    <!-- Orders -->
    <a href="/Order" class="dashboard-button">
        <div class="button-image">
            <img src="~/images/0273a839714b331e11076f2fe2628191.jpg" alt="Orders">
        </div>
        <span>Orders</span>
    </a>

    <!-- Files -->
    <a href="/Files/Upload" class="dashboard-button">
        <div class="button-image">
            <img src="~/images/97d48161ba9f10b1d4b013354c0541ed.jpg" alt="Files">
        </div>
        <span>Files</span>
    </a>
</div>

<style>
    .welcome {
        font-family: 'Playfair Display', serif;
        text-align: center;
        margin-bottom: 40px;
        color: #d4af37; /* elegant gold */
        font-size: 3rem;
    }

    .dashboard-container {
        display: flex;
        justify-content: center;
        gap: 25px;
        flex-wrap: wrap;
    }

    .dashboard-button {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-decoration: none;
        background-color: #fff;
        border-radius: 16px;
        width: 250px; /* bigger size */
        height: 250px; /* bigger size */
        overflow: hidden;
        transition: transform 0.25s, box-shadow 0.25s;
    }

    .button-image {
        flex: 1;
        width: 100%;
        height: 100%;
    }

        .button-image img {
            width: 100%;
            height: 100%;
            object-fit: cover; /* makes image fill block */
        }


    .dashboard-button span {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        text-align: center;
        padding: 8px 0;
        background: rgba(0, 0, 0, 0.6);
        color: #d4af37; /* gold */
        font-family: 'Playfair Display', serif;
        font-size: 1.1rem;
        font-weight: bold;
    }

    .dashboard-button:hover {
        transform: translateY(-6px);
        box-shadow: 0 10px 18px rgba(0,0,0,0.25);
    }
</style>
