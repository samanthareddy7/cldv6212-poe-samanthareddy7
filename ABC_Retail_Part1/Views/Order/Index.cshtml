@model ABC_Retail_Part1.Models.OrderIndexViewModel

<h2>Orders</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Place Order</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Customer</th>
            <th>Product</th>
            <th>Quantity</th>
            <th>Date</th>
            <th>Actions</th> <!-- Actions column -->
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model.Orders)
        {
            <tr>
                <td>@order.CustomerName</td>
                <td>@order.ProductName</td>
                <td>@order.Quantity</td>
                <td>
                    @* Safely display OrderDate in local time *@
                    @order.OrderDate?.ToLocalTime().ToString("g")
                </td>
                <td>
                    <a asp-action="Details" asp-route-rowKey="@order.RowKey" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Edit" asp-route-rowKey="@order.RowKey" class="btn btn-primary btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-rowKey="@order.RowKey" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<hr />

<h3>Queue Messages</h3>

@if (Model.QueueMessages != null && Model.QueueMessages.Any())
{
    <ul class="list-group">
        @foreach (var msg in Model.QueueMessages)
        {
            <li class="list-group-item">@msg</li>
        }
    </ul>
}
else
{
    <p>No queue messages yet.</p>
}
