@using System.Text.Json
@model ABC_Retail_Part1.Models.OrderIndexViewModel

@{
    ViewData["Title"] = "Orders";

    var userJson = Context.Session.GetString("CurrentUser");
    string role = null;
    string currentUserRowKey = null;

    if (!string.IsNullOrEmpty(userJson))
    {
        var u = JsonSerializer.Deserialize<JsonElement>(userJson);
        role = u.GetProperty("Role").GetString();

        // Only read CustomerRowKey if user is NOT admin
        if (role != "Admin" && u.TryGetProperty("CustomerRowKey", out var rowKeyProp))
        {
            // Must be stored as string in session
            currentUserRowKey = rowKeyProp.GetString();
        }
    }

    // FILTER ORDERS FOR NON-ADMINS
    IEnumerable<ABC_Retail_Part1.Models.Order> filteredOrders = Model.Orders;

    if (role != "Admin" && !string.IsNullOrEmpty(currentUserRowKey))
    {
        filteredOrders = Model.Orders.Where(o => o.CustomerRowKey == currentUserRowKey);
    }
}

<h2>Orders</h2>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchTerm" class="form-control" placeholder="Search by customer or product..." />
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </div>
</form>

@if (role != "Admin")
{
    <p>
        @* No create button for user *@
    </p>
}

<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Customer</th>
            <th>Product</th>
            <th>Quantity</th>
            <th>Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>

    @foreach (var order in filteredOrders)
    {
        var colorClass = order.Status switch
        {
            "Pending" => "status-pending",
            "Confirmed" => "status-confirmed",
            "Shipped" => "status-shipped",
            _ => "status-warning"
        };


        <tr>
            <td>@order.CustomerName</td>
            <td>@order.ProductName</td>
            <td>@order.Quantity</td>
            <td>@order.OrderDate?.ToLocalTime().ToString("g")</td>
            <td>
                @if (role == "Admin")
                {
                    <form asp-action="UpdateStatus" method="post" class="d-flex">
                        <input type="hidden" name="rowKey" value="@order.RowKey" />
                        <select name="newStatus" class="form-select form-select-sm me-2">
                            <option value="Pending" selected="@(order.Status == "Pending")">Pending</option>
                            <option value="Confirmed" selected="@(order.Status == "Confirmed")">Confirmed</option>
                            <option value="Shipped" selected="@(order.Status == "Shipped")">Shipped</option>
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Update</button>
                    </form>
                }
                else
                {
                    <span class="@colorClass">@order.Status</span>
                }
            </td>
            <td class="action-buttons">
                <a asp-action="Details" asp-route-rowKey="@order.RowKey" class="btn btn-outline-info btn-sm">Details</a>
                @if (role == "Admin")
                {
                    <a asp-action="Edit" asp-route-rowKey="@order.RowKey" class="btn btn-outline-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-rowKey="@order.RowKey" class="btn btn-outline-danger btn-sm">Delete</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
