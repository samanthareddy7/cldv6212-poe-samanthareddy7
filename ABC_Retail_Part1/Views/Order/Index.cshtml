@model ABC_Retail_Part1.Models.OrderIndexViewModel

<h2>Orders</h2>

<div class="table-card">
    <p>
        <a asp-action="Create" class="btn btn-primary">Place Order</a>
    </p>

    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Product</th>
                <th>Quantity</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.Orders)
            {
                <tr>
                    <td>@order.CustomerName</td>
                    <td>@order.ProductName</td>
                    <td>@order.Quantity</td>
                    <td>@order.OrderDate?.ToLocalTime().ToString("g")</td>
                    <td class="action-buttons">
                        <a asp-action="Details" asp-route-rowKey="@order.RowKey" class="btn btn-details btn-sm">
                            🔍 Details
                        </a>
                        <a asp-action="Edit" asp-route-rowKey="@order.RowKey" class="btn btn-edit btn-sm">
                            ✏️ Edit
                        </a>
                        <a asp-action="Delete" asp-route-rowKey="@order.RowKey" class="btn btn-delete btn-sm">
                            🗑️ Delete
                        </a>
                    </td>
                </tr>

            }
        </tbody>
    </table>
</div>

<hr />

<h3>Queue Messages</h3>

@if (Model.QueueMessages != null && Model.QueueMessages.Any())
{
    <ul class="list-group queue-messages">
        @foreach (var msg in Model.QueueMessages)
        {
            <li class="list-group-item">@msg</li>
        }
    </ul>
}
else
{
    <p>No queue messages yet.</p>
}
