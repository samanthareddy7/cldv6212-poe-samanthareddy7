@model ABC_Retail_Part1.Models.Order
@{
    ViewData["Title"] = "Delete Order";
}

<h2>Delete Order</h2>

<p>Are you sure you want to delete the order for <b>@Model.CustomerName</b> purchasing <b>@Model.ProductName</b>?</p>

<p>
    <b>Quantity:</b> @Model.Quantity<br />
    <b>Order Date:</b> @Model.OrderDate?.ToString("yyyy-MM-dd HH:mm")<br />
    <b>RowKey:</b> @Model.RowKey
</p>

<form asp-action="Delete" method="post">
    <input type="hidden" name="rowKey" value="@Model.RowKey" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
