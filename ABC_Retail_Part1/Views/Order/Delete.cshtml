@model ABC_Retail_Part1.Models.Order
<h2>Delete Order</h2>
<p>Are you sure you want to delete the order for <b>@Model.CustomerName</b> and product <b>@Model.ProductName</b>?</p>
<form asp-action="Delete" method="post">
    <input type="hidden" name="rowKey" value="@Model.RowKey" />
    <button type="submit" class="btn btn-danger">Delete</button>
</form>
<p><a asp-action="Index">Back to List</a></p>
