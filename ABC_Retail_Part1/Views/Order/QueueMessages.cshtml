@model List<string>
@{
    ViewData["Title"] = "Queue Messages";
}

<!-- Page container -->
<div style="min-height: 80vh; padding: 2rem;
            background: linear-gradient(135deg, #ffe0e9, #ffb6c1);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">

    <h2 style="text-align:center; margin-bottom:2rem; color:#800020;">Queue Messages</h2>

    @if (Model != null && Model.Count > 0)
    {
        <div style="display:flex; flex-direction:column; gap:1rem;">
            @foreach (var msg in Model)
            {
                <div style="background:white; border-radius:10px; padding:1rem 1.5rem;
                            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
                            border-left: 5px solid #ff69b4;">
                    <p style="margin:0; font-size:1.1rem; color:#333;">@msg</p>
                </div>
            }
        </div>
    }
    else
    {
        <p style="text-align:center; color:#333; font-size:1.2rem;">No messages in the queue.</p>
    }
</div>
