@using System.Text.Json
@model IEnumerable<ABC_Retail_Part1.Models.Product>

@{
    ViewData["Title"] = "Products";

    var userJson = Context.Session.GetString("CurrentUser");
    string role = null;
    bool isLoggedIn = false;

    if (!string.IsNullOrEmpty(userJson))
    {
        var u = JsonSerializer.Deserialize<JsonElement>(userJson);
        role = u.GetProperty("Role").GetString();
        isLoggedIn = true;
    }
}

<h2>Products</h2>

<div class="table-card">
    @* Only Admins see "Add New Product" *@
    @if (isLoggedIn && role == "Admin")
    {
        <p>
            <a asp-action="Create" class="btn btn-primary">Add New Product</a>
        </p>
    }

    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Description</td>
                <td>@item.Price.ToString("C")</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="Product Image" class="product-image" style="max-width:100px;" />
                    }
                </td>
                <td class="action-buttons">
                    @* Only show Add to Cart for logged-in non-admin users *@
                    @if (isLoggedIn && role != "Admin")
                    {
                        <form asp-controller="Cart" asp-action="AddToCart" method="post" style="display:flex; align-items:center; gap:5px; margin-top:5px;">
                            <input type="hidden" name="productId" value="@item.RowKey" />
                            <input type="number" name="quantity" value="1" min="1" class="form-control form-control-sm w-25" />
                            <button type="submit" class="btn btn-primary btn-sm">🛒 Add to Cart</button>
                        </form>
                    }
                    @* Admins can edit/delete products here if you want *@
                    @if (isLoggedIn && role == "Admin")
                    {
                        <a asp-action="Edit" asp-route-rowKey="@item.RowKey" class="btn btn-edit btn-sm mb-1">✏️ Edit</a>
                        <a asp-action="Delete" asp-route-rowKey="@item.RowKey" class="btn btn-delete btn-sm mb-1">🗑️ Delete</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
