@model IEnumerable<ABC_Retail_Part1.Models.Product>

<h2>Products</h2>

<div class="table-card">
    <p>
        <a asp-action="Create" class="btn btn-primary">Add New Product</a>
    </p>

    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Image</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Description</td>
                    <td>@item.Price</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="Product Image" class="product-image" />
                        }
                    </td>
                    <td class="action-buttons">
                        <a asp-action="Details" asp-route-rowKey="@item.RowKey" class="btn btn-details btn-sm">
                            <span class="emoji">🔍</span> Details
                        </a>
                        <a asp-action="Edit" asp-route-rowKey="@item.RowKey" class="btn btn-edit btn-sm">
                            <span class="emoji">✏️</span> Edit
                        </a>
                        <a asp-action="Delete" asp-route-rowKey="@item.RowKey" class="btn btn-delete btn-sm">
                            <span class="emoji">🗑️</span> Delete
                        </a>

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
