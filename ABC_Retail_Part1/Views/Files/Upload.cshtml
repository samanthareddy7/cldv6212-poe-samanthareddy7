@model List<ABC_Retail_Part1.Models.FileViewModel>
@{
    var customerName = ViewBag.CustomerName as string ?? "general";
}

<h2>Files for @customerName</h2>

<!-- File Upload Form -->
<form asp-action="UploadFile" method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label>Select File</label>
        <input type="file" name="file" class="form-control" />
    </div>
    <button type="submit" class="btn btn-pink">Upload</button>
</form>

<hr />

<h3>Files</h3>

@if (Model.Any())
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>File Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var file in Model)
            {
                <tr>
                    <td>@file.FileName</td>
                    <td>
                        <a asp-action="DownloadFile" asp-route-customerName="@file.CustomerName" asp-route-fileName="@file.FileName" class="btn btn-primary btn-sm">Download</a>
                        <form asp-action="DeleteFile" method="post" style="display:inline;">
                            <input type="hidden" name="customerName" value="@file.CustomerName" />
                            <input type="hidden" name="fileName" value="@file.FileName" />
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No files found for this customer.</p>
}
